{
  "entities": {
    "command": {
      "title": "Command",
      "description": "Developer CLI command documentation with metadata and safety categorization",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Human readable name of the command"
        },
        "command": {
          "type": "string",
          "maxLength": 5000,
          "description": "CLI syntax text to copy and view"
        },
        "description": {
          "type": "string",
          "maxLength": 1500,
          "description": "Explanation of command flags and purpose"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Command category such as Linux, Bash, Git, Docker, NPM, etc."
        },
        "tags": {
          "type": "array",
          "description": "Searchable tags for quick filtering"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Visibility scope of the command"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user who created this command"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name or email of the author"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "command", "description", "category", "visibility", "ownerUid"]
    },
    "favorite": {
      "title": "Favorite",
      "description": "A bookmarked command reference for an authenticated user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user"
        },
        "commandId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the bookmarked command"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added to favorites"
        }
      },
      "required": ["userId", "commandId"]
    },
    "admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Authorized admin email address"
        },
        "role": {
          "type": "string",
          "maxLength": 50,
          "description": "Admin role identifier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of grant"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/commands/{commandId}": {
      "schema": "command",
      "description": "Library of public developer commands and private owner commands"
    },
    "/users/{userId}/favorites/{commandId}": {
      "schema": "favorite",
      "description": "User specific command bookmarks"
    },
    "/admins/{adminUid}": {
      "schema": "admin",
      "description": "Allowlisted administrator records"
    }
  }
}
